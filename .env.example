# Public build settings. Copy to .env.local or set in your hosting dashboard.
# Do not put API keys or other secrets in NEXT_PUBLIC_* variables.
# Empty = local preview (noindex); required for npm run build:release.
NEXT_PUBLIC_SITE_URL=
# Optional: a real public HTTPS résumé URL or /sami-abu-raaed-cv.pdf in public/.
# Empty = résumé link hidden. No source-code edits are needed.
NEXT_PUBLIC_RESUME_URL=

# Optional local tooling overrides; defaults shown in API_SETUP.md.
# PORT=3000
# HOST=127.0.0.1
# CHROME_PATH=
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# AUDIT_URL=http://127.0.0.1:3000
# AUDIT_RUNS=3
