{
  "name": "sami-abu-raaed-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/check-config.mjs && next build --webpack && node scripts/prepare-export.mjs",
    "build:release": "node scripts/check-config.mjs --release && npm run build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "audit": "node scripts/audit.mjs",
    "assets": "node scripts/assets.mjs",
    "brand": "node scripts/brand.mjs",
    "check:config": "node scripts/check-config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test tests/*.test.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "5.3.0",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.6",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "13.6.0",
    "prettier": "^3.6.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  }
}
